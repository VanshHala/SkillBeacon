# ==========================================
# SkillBeacon — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control!

# --- Frontend (Vite) ---
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
VITE_API_BASE_URL=http://localhost:8080/api

# --- Backend (Spring Boot) ---
# These are set as system environment variables or in your deployment platform.

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/skillbeacon?stringtype=unspecified
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_ISSUER_URI=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Apify (Web Scraping)
APIFY_API_TOKEN=your_apify_token_here
APIFY_BASE_URL=https://api.apify.com/v2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Server
PORT=8080
